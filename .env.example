# Variable NAMES only - never commit real values. Copy to apps/web/.env.local for local development.
# Use a SEPARATE Supabase *development* project. Never put mtg-production credentials here.

NEXT_PUBLIC_SITE_URL=                 # e.g. http://localhost:3000 (dev); used in emailed verification/recovery links
NEXT_PUBLIC_SUPABASE_URL=             # dev project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # dev project anon/publishable key (safe for browser; RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=            # server/CI only; bypasses RLS; never expose to the browser or logs

# Integrations - all READ-ONLY until the owner approves otherwise
NOTION_TOKEN=                         # Notion integration token with READ-ONLY capabilities
NOTION_MASTER_JOB_V1_DB_ID=           # a5cfe2a2... data source / database ids are configuration, not secrets
NOTION_MASTER_JOB_V2_DB_ID=
NOTION_CANDIDATE_POOL_DB_ID=
NOTION_COMPANY_DB_ID=
NOTION_JOB_AUDIT_LOG_DB_ID=
N8N_WEBHOOK_SECRET=                   # HMAC secret for inbound webhooks (no workflows are activated by this repo)

# AI (provider-independent; mock by default)
AI_PROVIDER=mock                      # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Messaging - MUST stay dry-run until the owner approves real sends
WAHA_BASE_URL=
WAHA_API_KEY=
MESSAGING_DRY_RUN=true
