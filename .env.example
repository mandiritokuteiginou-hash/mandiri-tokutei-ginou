NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: enables the "Sync dari Notion" button in /admin/dashboard.
# NOTION_API_KEY is an internal integration token (notion.so/my-integrations)
# that has been given access to the "💼 Job Posting" database.
# NOTION_JOB_POSTING_DATABASE_ID is that database's ID.
NOTION_API_KEY=
NOTION_JOB_POSTING_DATABASE_ID=
