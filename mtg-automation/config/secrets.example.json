{
 "_note": "PLACEHOLDERS ONLY. Never commit real secrets.",
 "credentials_to_create_in_n8n": {
  "Notion Bearer (Header Auth)": {
   "type": "httpHeaderAuth",
   "name": "Authorization",
   "value": "Bearer <NOTION_INTEGRATION_SECRET>"
  },
  "Anthropic API Key (x-api-key)": {
   "type": "httpTemplatedCustomAuth (Custom Auth)",
   "header": "x-api-key",
   "value": "<ANTHROPIC_API_KEY>"
  },
  "gBizINFO API Token": {
   "type": "httpHeaderAuth",
   "name": "X-hojinInfo-api-token",
   "value": "<GBIZINFO_TOKEN>"
  },
  "HTML-to-Image Render API (Basic Auth)": {
   "type": "httpBasicAuth",
   "user": "<USER>",
   "password": "<PASS>"
  },
  "Blotato API Key (header)": {
   "type": "httpHeaderAuth",
   "name": "<VERIFY_HEADER_NAME>",
   "value": "<BLOTATO_KEY>"
  },
  "WhatsApp bridge API key": {
   "type": "httpHeaderAuth",
   "name": "<VERIFY>",
   "value": "<KEY>",
   "note": "a WAHA credential (wahaApi) already exists in n8n; VERIFY if WAHA is the bridge"
  },
  "n8n API key (X-N8N-API-KEY)": {
   "type": "httpHeaderAuth",
   "name": "X-N8N-API-KEY",
   "value": "<N8N_API_KEY>"
  }
 },
 "config_values_not_in_credentials": {
  "WF09.hash_salt": "<stable secret>",
  "WF10.n8n_api_base": "https://<host>/api/v1",
  "WF10.alert_webhook_url": "<optional>",
  "WF09.whatsapp_inbox_url": "<optional bridge GET URL>"
 }
}